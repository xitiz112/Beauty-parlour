generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
  completed
  no_show
}

model ServiceCategory {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  teaser    String
  fromPrice Int
  image     String
  mediaUrls String[]  @default([])
  featured  Boolean   @default(false)
  sortOrder Int       @default(0)
  services  Service[]
}

model Service {
  id              String           @id @default(cuid())
  categoryId      String
  category        ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int
  price           Int
  description     String?
  image           String?
  mediaUrls       String[]         @default([])
  published       Boolean          @default(true)
  sortOrder       Int              @default(0)
  stylists        StylistService[]
  appointments    Appointment[]
  ritualPicks     RitualPick[]
}

model Stylist {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  role         String
  specialty    String
  image        String
  mediaUrls    String[]         @default([])
  published    Boolean          @default(true)
  sortOrder    Int              @default(0)
  services     StylistService[]
  hours        WorkingHour[]
  appointments Appointment[]
}

model StylistService {
  stylistId String
  serviceId String
  mediaUrls String[] @default([])
  stylist   Stylist  @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([stylistId, serviceId])
}

model WorkingHour {
  id        String   @id @default(cuid())
  mediaUrls String[] @default([])
  stylistId String
  stylist   Stylist  @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startMin  Int
  endMin    Int

  @@unique([stylistId, dayOfWeek])
}

model Appointment {
  id        String            @id @default(cuid())
  guestName String
  phone     String
  email     String?
  notes     String?
  mediaUrls String[]          @default([])
  serviceId String
  service   Service           @relation(fields: [serviceId], references: [id])
  stylistId String
  stylist   Stylist           @relation(fields: [stylistId], references: [id])
  startsAt  DateTime
  endsAt    DateTime
  status    AppointmentStatus @default(pending)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([stylistId, startsAt])
  @@index([status])
}

model Review {
  id        String   @id @default(cuid())
  guestName String
  service   String
  rating    Int
  quote     String
  mediaUrls String[] @default([])
  published Boolean  @default(true)
  sortOrder Int      @default(0)
}

model GalleryItem {
  id        String   @id @default(cuid())
  caption   String
  image     String
  mediaUrls String[] @default([])
  published Boolean  @default(true)
  sortOrder Int      @default(0)
}

model Offer {
  id        String    @id @default(cuid())
  title     String
  detail    String
  mediaUrls String[]  @default([])
  cta       String
  eyebrow   String?
  expiresAt DateTime?
  active    Boolean   @default(true)
}

model Signature {
  id            String   @id @default(cuid())
  name          String
  story         String
  fromPrice     Int
  image         String
  mediaUrls     String[] @default([])
  categorySlug  String
  treatmentName String
  inclusions    String[] @default([])
  sortOrder     Int      @default(0)
}

model InstagramPost {
  id        String   @id @default(cuid())
  image     String
  mediaUrls String[] @default([])
  alt       String
  sortOrder Int      @default(0)
}

model StudioSetting {
  id                 String   @id @default("studio")
  name               String
  shortName          String
  tagline            String
  city               String
  neighborhood       String
  address            String
  landmark           String
  phone              String
  phoneHref          String
  whatsapp           String
  whatsappHref       String
  email              String
  instagram          String
  instagramHref      String
  facebookHref       String
  mapsEmbed          String
  parking            String
  walkIns            String
  confirmNote        String
  aboutWords         String
  mediaUrls          String[] @default([])
  aboutImage         String
  heroImage          String
  googleScore        String
  googleCount        String
  ownerName          String
  ownerRole          String
  // Header & footer copy (Admin → Header & footer)
  logoSubtitle       String   @default("Beauty Studio")
  headerCtaLabel     String   @default("Book an appointment")
  showHeaderPhone    Boolean  @default(true)
  footerVisitTitle   String   @default("Visit")
  footerExploreTitle String   @default("Explore")
  footerSocialTitle  String   @default("Follow us")
  copyrightText      String   @default("All rights reserved.")
}

enum NavLocation {
  header
  footer_explore
  footer_legal
}

model NavLink {
  id           String      @id @default(cuid())
  location     NavLocation
  label        String
  href         String
  newTab       Boolean     @default(false)
  opensBooking Boolean     @default(false)
  sortOrder    Int         @default(0)
  published    Boolean     @default(true)

  @@index([location, sortOrder])
}

model SocialLink {
  id        String  @id @default(cuid())
  platform  String
  label     String
  href      String
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  mediaUrls    String[] @default([])
}

// --- Homepage content (Admin → Homepage) ---

// Copy for one homepage section, keyed by section id (hero, services, about, …).
model SectionContent {
  key               String  @id
  eyebrow           String  @default("")
  title             String  @default("")
  body              String  @default("")
  details           String  @default("")
  ctaLabel          String  @default("")
  secondaryCtaLabel String  @default("")
  visible           Boolean @default(true)
}

model HeroSlide {
  id        String   @id @default(cuid())
  image     String
  alt       String
  mediaUrls String[] @default([])
  sortOrder Int      @default(0)
  published Boolean  @default(true)
}

model TrustItem {
  id        String  @id @default(cuid())
  value     String
  suffix    String  @default("")
  label     String
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model RitualPick {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  note      String
  detail    String
  sortOrder Int     @default(0)
  published Boolean @default(true)
}
