# Local PostgreSQL from docker-compose.yml
DATABASE_URL=postgresql://liora:liora@localhost:5434/liora?schema=public

# Required by Auth.js (generate a unique secret; never commit the actual value)
AUTH_SECRET=replace-with-a-random-secret

# Optional: required for admin media uploads to Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Optional local desk seed values
ADMIN_EMAIL=desk@liorastudio.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Studio desk
